#
# Optional asm dependency — present as .S or .s depending on the port
cpu_support_.o: $(wildcard $(KERNEL_DIR)/config/$(KERNEL_DEV)/cpu_support.S) \
                $(wildcard $(KERNEL_DIR)/config/$(KERNEL_DEV)/cpu_support.s)
ittrium.o: eventflags.c mailbox.c semaphore.c task.c time_manage.c timer.c \
           tsk_dep_syn.c tsk_manage.c wait.c cpu_support.h kernel_config.h \
           cpu_support.c
