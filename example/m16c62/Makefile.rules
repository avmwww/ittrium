##################################################################
# Smoke example for config/m16c62
# Requires IAR Embedded Workbench tools on PATH (iccarm / aarm / etc.),
# or set IAR_ARM_DIR / IAR_M16C_DIR to the compiler bin directory.
KERNEL_DIR ?= $(PWD)/../..
KERNEL_DEV = m16c62
OBJDIR = obj
RM = rm -rf
MKDIR = mkdir -p
#
# Default recipe is a clear error — wire your IAR project or override CC/ASM/LNK.
ifeq ($(IAR_BUILD),1)
include Makefile.iar
else
all:
	@echo "example/m16c62: set IAR_BUILD=1 after configuring Makefile.iar,"
	@echo "or open an EWARM/EWM16C project pointing at config/m16c62."
	@echo "Sources: kernel/ittrium.c + config/m16c62/cpu_support.* + src/src/test.c"
	@false
endif
clean:
	$(RM) $(OBJDIR) $(TARGET)
.PHONY: all clean
