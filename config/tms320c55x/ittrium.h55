        .include  "tms320c55x.h55"
        .include  "kernel_config.h55"

; TCB offsets in 16-bit words (large model). Keep in sync with kernel/task.h —
; verify with offsetof() under cl55 --memory_model=large if the TCB changes.
; KQUEUE qnode: 0..3
TCB_sp       .set    4
TCB_ssp      .set    6
TCB_pc       .set    8
TCB_task     .set   10
TCB_stk      .set   12
TCB_sstk     .set   14
TCB_stksz    .set   16
TCB_stk_base .set   18
TCB_run_ticks .set  20
TCB_tskid    .set   22
TCB_exinf    .set   24

        .ref _runtsk
        .ref _schedtsk

        .global _main

        .ref cinit
        .ref ___bss__
        .ref ___pinit__
        .ref ___end__
